rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // User can always read their own profile.
      allow read: if request.auth != null && request.auth.uid == userId;

      // User can CREATE their document freely (first time signup).
      allow create: if request.auth != null && request.auth.uid == userId;

      // User can UPDATE, BUT NOT TOUCH SUBSCRIPTION FIELDS.
      allow update: if request.auth != null
          && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).changedKeys().hasAny([
            'plan',
            'subscriptionStatus',
            'subscriptionId',
            'currentPeriodEnd'
          ]);

      allow delete: if false;
    }
  }
}
